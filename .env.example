# BrightData — Residential / Datacenter proxy
BRIGHTDATA_HOST=brd.superproxy.io
BRIGHTDATA_PORT=22225
BRIGHTDATA_USERNAME=your_username
BRIGHTDATA_PASSWORD=your_password

# BrightData — Scraping Browser (WebSocket endpoint)
BRIGHTDATA_WS_ENDPOINT=wss://brd-customer-XXX-zone-scraping_browser@zproxy.lum-superproxy.io:9222

# BrightData — REST API (usado por middlewares/)
BRIGHTDATA_API_KEY=your_brightdata_api_key

# ---------------------------------------------------------------------------
# Dual-mode BrightData resource ids per scraper (see docs/fase3/middleware-dual-mode.md)
# ---------------------------------------------------------------------------
# For each scraper, populate EITHER the DATASET_ID (v3 / Scraper Studio) OR
# the COLLECTOR_ID (DCA legacy). If both are set, the middleware uses v3 and
# ignores the DCA entry (v3 wins — assumes the migration to Studio is done).

# --- cosmetics-design -------------------------------------------------------
# Dataset id (v3 / Scraper Studio). Format gd_...
BRIGHTDATA_DATASET_ID_COSMETICS_DESIGN=your_dataset_id_from_dashboard
# Collector id (DCA legacy). Format c_...
# Only used when DATASET_ID_COSMETICS_DESIGN is NOT set.
# BRIGHTDATA_COLLECTOR_ID_COSMETICS_DESIGN=c_mo881p3h23z6ctghqw

# --- cosme ------------------------------------------------------------------
# BRIGHTDATA_DATASET_ID_COSME=gd_...
# BRIGHTDATA_COLLECTOR_ID_COSME=c_mo7zv65x2914uyi2n4

# --- cosme-ranking-products -------------------------------------------------
# BRIGHTDATA_DATASET_ID_COSME_RANKING=gd_...
# BRIGHTDATA_COLLECTOR_ID_COSME_RANKING=c_mohk9yhu2b1qsuso67

# --- olive-young ------------------------------------------------------------
# BRIGHTDATA_DATASET_ID_OLIVE_YOUNG=gd_...
# BRIGHTDATA_COLLECTOR_ID_OLIVE_YOUNG=c_mob060tkv07mp3ft9

# --- alibaba ----------------------------------------------------------------
# BRIGHTDATA_DATASET_ID_ALIBABA=gd_...
# BRIGHTDATA_COLLECTOR_ID_ALIBABA=c_mnypbnxc1u871q7sgb

# --- made-in-china ----------------------------------------------------------
# BRIGHTDATA_DATASET_ID_MADE_IN_CHINA=gd_...
# BRIGHTDATA_COLLECTOR_ID_MADE_IN_CHINA=c_mo8p01aj1401mhi4sn

# --- indiamart --------------------------------------------------------------
# BRIGHTDATA_DATASET_ID_INDIAMART=gd_...
# BRIGHTDATA_COLLECTOR_ID_INDIAMART=c_mo90ehh42wq2ili8

# --- cosme-new-arrivals -----------------------------------------------------
# BRIGHTDATA_DATASET_ID_COSME_NEW_ARRIVALS=gd_...
# BRIGHTDATA_COLLECTOR_ID_COSME_NEW_ARRIVALS=c_mord1htg2qb2o0uwpy

# --- olive-young-new-arrivals ------------------------------------------------
# BRIGHTDATA_DATASET_ID_OLIVE_YOUNG_NEW_ARRIVALS=gd_...
# BRIGHTDATA_COLLECTOR_ID_OLIVE_YOUNG_NEW_ARRIVALS=c_moqkkvdq8xisc0fed

# --- Generic DCA collector (used ONLY by scripts/test_connector.py, not by
# the middleware layer). Kept for the historical smoke-test script.
# BRIGHTDATA_COLLECTOR_ID=c_...

# Anthropic — agent_harness/ y futuros clientes del SDK
ANTHROPIC_API_KEY=sk-ant-...

# Harness de agente (agent_harness/app.py): fixture | live
AGENT_MODE=fixture



Example curls brightdata# ---------------------------------------------------------------------------
# Curls de ejemplo para testear los endpoints del middleware layer (ver docs/curls.md)
# ---------------------------------------------------------------------------


# olive-young (DCA legacy collector):
# curl -H "Authorization: Bearer API_TOKEN" -H "Content-Type: application/json" -d '[{"url":"https://global.oliveyoung.com/display/page/best-seller","max_pages":3}]' "https://api.brightdata.com/dca/trigger?collector=c_mob060tkv07mp3ft9&confirm_cancel=1"


